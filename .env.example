# OmniIDEA environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Required: LLM provider (OpenAI-compatible API) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL for OpenAI-compatible gateways
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Required: web search ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Optional: web page extraction (Jina Reader) ---
# JINA_API_KEY=your_jina_api_key_here

# --- Optional: inference settings ---
TEMPERATURE=0.7
MAX_NEW_TOKENS=16384

# --- Optional: agent retry behavior ---
# AGENT_INVOKE_MAX_RETRIES=3
# AGENT_RETRY_BASE_DELAY=2
# AGENT_RETRY_MAX_DELAY=8

# --- Optional: LangSmith tracing ---
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=omniidea
